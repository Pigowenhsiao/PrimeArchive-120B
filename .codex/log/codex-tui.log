2025-12-27T09:05:18.600505Z  INFO ToolCall: shell_command {"command":"cat <<'EOF' > /home/pigo/文件/python/PrimeArchive-120B/configs/config.yaml\n# PrimeArchive-120B: 通用書籍轉換框架配置文件\n\nproject:\n  name: \"PrimeArchive-120B\"\n  version: \"2.0.0-universal\"\n  description: \"Automated Book-to-RAG Knowledge Synthesis\"\n\n# ------------------------------------------\n# 1. 本地 LLM 配置 (Ollama / Local API)\n# ------------------------------------------\nllm_settings:\n  model_name: \"gpt-oss:120B-cloud\"\n  base_url: \"http://localhost:11434/v1\" # Ollama 默認路徑\n  temperature: 0.1                      # 低隨機性，確保事實準確\n  num_ctx: 8192                         # 上下文窗口限制\n  top_p: 0.9\n  repeat_penalty: 1.1\n  max_tokens: 2048                      # 單次生成最大長度\n  timeout: 180                          # 單次 API 調用超時 (秒)\n\n# ------------------------------------------\n# 2. 通用書籍提取與切分策略 (ETL Strategy)\n# ------------------------------------------\nextraction:\n  supported_formats: [\".pdf\", \".epub\", \".docx\", \".txt\", \".md\"]\n  auto_clean: true                      # 自動移除頁碼與重複腳註\n  ocr_enabled: false                    # 若為掃描版 PDF 需開啟 (需額外套件)\n\nchunking:\n  # 預設通用切分邏輯\n  default:\n    method: \"markdown\"                 # 依 Markdown 標題層級優先切分\n    size: 1000                          # 字符數上限\n    overlap: 100                        # 段落重疊區間\n\n  # 領域自適應預設 (Domain Presets)\n  domain_presets:\n    technical:                          # 技術手冊/教材\n      size: 800\n      overlap: 150\n    literature:                         # 小說/敘事\n      size: 1500\n      overlap: 200\n    legal:                              # 條文/法律\n      size: 600\n      overlap: 50\n\n# ------------------------------------------\n# 3. 數據契約規格 (Data Schema Enforcement)\n# ------------------------------------------\noutput_schema:\n  enforce_json: true                    # 強制 LLM 輸出 JSON\n  fields:\n    - \"concept\"                         # 核心概念\n    - \"description\"                     # 知識描述\n    - \"application\"                     # 實作/場景\n    - \"tags\"                            # 標籤\n    - \"confidence\"                      # 置信度 (0.0 - 1.0)\n  export_format: \"jsonl\"                # 適合大型向量庫導入\n\n# ------------------------------------------\n# 4. 資源監控與錯誤恢復 (Reliability)\n# ------------------------------------------\nreliability:\n  retry_limit: 3                        # 生成失敗重試次數\n  checkpoint_interval: 10               # 每處理 10 個 Chunk 保存一次進度\n  vram_protection: 0.90                 # 顯存佔用超過 90% 時自動排隊等待\n  error_handling: \"skip_and_log\"        # 遇錯時跳過並記錄，不中斷全程\n\n# ------------------------------------------\n# 5. 向量庫儲存配置 (Vector Store)\n# ------------------------------------------\nvector_store:\n  provider: \"chromadb\"\n  persist_dir: \"./data/vector_db\"\n  embedding_model: \"BAAI/bge-m3\"        # 中英日多語言通用模型\n  collection_name_prefix: \"arch_v1_\"\nEOF\n","workdir":"/home/pigo/文件/python/PrimeArchive-120B"}
